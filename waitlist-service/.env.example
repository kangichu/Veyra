PORT=8787
ALLOWED_ORIGIN=https://www.tandish.com

# Mailbox used to send both the notification and the auto-reply.
# For Gmail: smtp.gmail.com, port 587, and an App Password (not your normal password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional: defaults to SMTP_USER if unset.
MAIL_FROM=hello@tandish.com

# Where new-signup notifications are sent.
NOTIFY_TO=hello@tandish.com
